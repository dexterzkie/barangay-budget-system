// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password      String
  role          String   @default("Resident")
  fullName      String
  firstName     String?
  lastName      String?
  email         String?  @unique
  contactNumber String?
  address       String?
  status        String   @default("Approved") // Pending, Approved, Rejected
  createdAt     DateTime @default(now())
}

model FundAllocation {
  id              Int           @id @default(autoincrement())
  fundType        String        @unique
  allocatedAmount Float
  status          String        @default("Approved")
  expenditures    Expenditure[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Expenditure {
  id               Int            @id @default(autoincrement())
  date             DateTime
  referenceNo      String         @unique
  description      String
  amount           Float
  status           String         @default("Approved")
  fundAllocationId Int
  fundAllocation   FundAllocation @relation(fields: [fundAllocationId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}
